from turtle import *
from random import randint
import numpy as np
from time import sleep

t = Turtle()


def plano(a,b):
    t.teleport(0,0)
    t.goto(a,0)
    t.stamp()
    t.left(180)
    t.goto(-a,0)
    t.stamp()
    t.left(90)
    t.teleport(0,0)
    t.goto(0,b)
    t.stamp()
    t.left(180)
    t.goto(0,-b)
    t.stamp()


t1 = Turtle()
t1.hideturtle()
def formula1():
    t1.showturtle()
    t1.teleport(0,0)
    t1.color("red")
    for i in range(200):
        t1.goto(i,i**(1/2))
    t1.hideturtle()
    sleep(5)
    t1.clear()
