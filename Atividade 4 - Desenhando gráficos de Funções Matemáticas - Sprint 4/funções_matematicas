def corrida(n):
    p = {}
    chegada = True
    for i in range(n):
        p[i] = Turtle()
        p[i].shape("turtle")
        r = randint(3,8)/10
        g = randint(3,8)/10
        b = randint(3,8)/10
        p[i].color(r, g, b)
    for m in p:
        p[m].teleport(0,0+20*m)

    while chegada:
        for j in p:
            p[j].forward(randint(1, 10))
            if p[j].xcor() >= 200:
                chegada = False
                break

    
    

corrida(5)
    

mainloop()